  "task_field_priority": {
    "title": [
      "category identity",
      "brand/model",
      "one highest-confidence differentiating function/parameter/specification"
    ],
    "selling_points": [
      "up to three eligible function/parameter/specification facts; one fact per point"
    ],
    "short_description": [
      "category identity plus up to three eligible facts, without adding unsupported use cases or benefits"
    ]
  },
  "selection_policy": {
    "identity_order": [
      "category_l1",
      "category_l2",
      "品牌",
      "型号"
    ],
    "conditional_fields_enabled": false,
    "distinct_multi_value_action": "withhold_review",
    "task_group_priority": {
      "title": [
        "parameter",
        "function",
        "specification"
      ],
      "selling_points": [
        "function",
        "parameter",
        "specification"
      ],
      "short_description": [
        "specification",
        "function",
        "parameter"
      ]
    },
    "global_joint_ranking": {
      "method": "reciprocal_rank_fusion",
      "tasks": [
        "title",
        "selling_points",
        "short_description"
      ],
      "rrf_k": 60,
      "tie_breakers": [
        "sum_task_ranks",
        "field_order",
        "canonical_field",
        "fact_id"
      ]
    }
  },
  "initial_retrieval_proposal": {
    "basis": "validation only plus PRD/Week2 constraints",
    "identity_information": "category_l1, category_l2, and eligible brand/model supplied separately and not counted in Top-K",
    "top_k": 3,
    "top_k_status": "validation_initial_not_frozen",
    "candidate_filter": "same product_id and quality_status=eligible only",
    "ranking": "global reciprocal-rank fusion over title, selling_points, and short_description task rankings",
    "confidence_threshold": "eligible gate; no numeric similarity threshold proposed in this stage",
    "if_fewer_than_k": "return fewer facts; never pad with low-confidence or other-product facts",
    "negative_constraints": "all same-product eligible negative facts are supplied as read-only constraints outside content Top-K"
  },
  "negative_constraint_policy": {
    "role": "read_only_constraint_outside_content_top_k",
    "quality_gate": "fact_role=task and quality_status=eligible only",
    "exact_values": [
      "无",
      "否",
      "不支持",
      "有线",
      "没有",
      "未配备"
    ],
    "contains_values": [
      "不支持"
    ],
    "active_generation": false,
    "requires_same_product_id": true
  }
