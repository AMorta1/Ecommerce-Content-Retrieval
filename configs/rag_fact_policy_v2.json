  "design_basis": {
    "requirements": [
      "PRD stage 3 lightweight RAG",
      "Week2.md P1 lightweight RAG",
      "Leader 9.18 feedback"
    ],
    "development_split": "validation",
    "test100_role": "quality attribution only; not used for whitelist, ranking, Top-K, threshold, or prompt selection",
    "model_execution_in_this_stage": false,
    "model_revision": "not_applicable_no_model_loaded",
    "source_datasets": [
      {
        "scope": "validation",
        "path": "data/processed/week1_v3/multimodal/validation.jsonl",
        "sha256": "dd2bc1d6c21567176d95f5414bfd9304f48979b3bb39ab0b038627b1f346af0b",
        "count": 200
      },
