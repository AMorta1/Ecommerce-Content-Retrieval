        "count": 100
      }
    ]
  },
  "source_boundary": {
    "retrieval_scope": "same_product_id_only",
    "fact_source": "normalized structured attributes plus standardized category",
    "audit_evidence_only": [
      "original title",
      "main image"
    ],
    "never_fact_source": [
      "model generated copy",
      "baseline output",
      "human evaluation comments",
      "other products"
    ],
    "original_title_in_prompt": false,
    "reason": "Baseline generation input excludes the original title; title and image are used to judge source reliability, not injected as generation facts."
  },
  "confirmed_decisions": {
    "identity_quality_gate": "category, brand, and model are supplied outside Top-K only when eligible",
    "review_handling": "withhold only flagged fields; unrelated stable fields remain eligible",
    "conflict_handling": "identity or category conflict blocks every fact for that product; ordinary field conflict blocks only that field",
    "top_k_status": "Top-3 is an initial validation setting and is not frozen"
  },
  "fact_unit_schema": {
    "fact_id": "{dataset_version}:{split}:{product_id}:{canonical_field}:{normalized_value_sha256_12}",
    "required_fields": [
      "fact_id",
      "product_id",
      "dataset_version",
      "split",
      "category_l1",
      "category_l2",
      "knowledge_level",
      "fact_role",
      "field_group",
      "field_order",
      "field_name",
      "canonical_field",
      "raw_values",
      "normalized_values",
      "task_tags",
      "quality_status",
      "quality_reasons",
      "evidence",
      "source_path",
      "source_sha256"
    ],
    "knowledge_level_values": [
      "category",
      "function",
      "parameter",
      "specification"
    ],
    "task_tag_values": [
      "title",
      "selling_points",
      "short_description"
    ],
    "quality_status_values": [
      "eligible",
      "withhold_review",
      "blocked_conflict"
    ],
    "evidence_fields": [
      "structured_source",
      "title_consistency",
      "image_consistency",
      "audit_version"
    ]
  },
  "record_status_policy": {
    "PASS": "Only whitelisted, non-placeholder facts are eligible.",
    "REVIEW": "Keep the frozen record; withhold flagged fields until independent evidence resolves the SKU or boundary. Unrelated stable fields may remain eligible.",
    "CONFLICT": "Keep the frozen record; block conflicting fields. If category/product identity conflicts, block all facts for generation and report Source Fact Error."
  },
  "global_value_gates": {
    "exclude_placeholders": [
      "其他",
      "其它",
      "OTHER",
      "other",
      "未知",
      "不详",
      "默认",
      "见描述",
      "如图",
      "0kg"
    ],
    "multi_value_rule": "Keep multiple values only when they are equivalent after normalization or explicitly represent a set that the task can state without selecting a SKU. Otherwise withhold.",
    "numeric_rule": "Normalize units and compare exact values/ranges. Block incompatible point values, impossible ranges, and unverified marketing capacities.",
    "identity_rule": "Brand/model/category must not conflict with title or image audit evidence.",
    "no_padding": true
  },
  "global_excluded_fields": {
    "fields": [
      "颜色分类",
      "套餐类型",
      "成色",
      "售后服务",
      "保修期",
      "上市时间",
