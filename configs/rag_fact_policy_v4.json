        "移动电源",
        "保温杯",
        "收纳箱",
        "拖把",
        "垃圾桶"
      ]
    },
    "no_padding": true,
    "composite_placeholder_separator_pattern": "[/\\\\|,，;；、]+",
    "composite_placeholder_rule": "Exclude a value when splitting on configured separators yields two or more tokens and every token is an existing placeholder; keep mixed placeholder-plus-real values."
  },
