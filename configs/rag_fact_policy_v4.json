      "mandatory_status",
      "mandatory_reasons",
      "evidence",
      "source_path",
      "source_sha256"
    ],
    "knowledge_level_values": [
      "category",
      "function",
      "parameter",
      "specification"
    ],
    "task_tag_values": [
      "title",
      "selling_points",
      "short_description"
    ],
    "quality_status_values": [
      "eligible",
      "withhold_review",
      "blocked_conflict"
