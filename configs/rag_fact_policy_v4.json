  "task_field_priority": {
    "title": [
      "category identity",
      "brand/model",
      "one highest-confidence differentiating function/parameter/specification"
    ],
    "selling_points": [
      "up to three eligible function/parameter/specification facts; one fact per point"
    ],
    "short_description": [
      "category identity plus up to three eligible facts, without adding unsupported use cases or benefits"
    ]
  },
  "selection_policy": {
    "identity_order": [
      "category_l1",
      "category_l2",
      "品牌",
      "型号"
    ],
    "conditional_fields_enabled": true,
    "distinct_multi_value_action": "withhold_review",
    "task_group_priority": {
      "title": [
        "parameter",
        "function",
        "specification"
      ],
      "selling_points": [
        "function",
        "parameter",
        "specification"
      ],
      "short_description": [
        "specification",
        "function",
        "parameter"
      ]
    },
    "global_joint_ranking": {
      "method": "reciprocal_rank_fusion",
      "tasks": [
        "title",
        "selling_points",
        "short_description"
      ],
      "rrf_k": 60,
      "tie_breakers": [
        "sum_task_ranks",
        "field_order",
        "canonical_field",
        "fact_id"
      ]
    }
  },
  "initial_retrieval_proposal": {
    "basis": "frozen core definition plus week2_train_v1 and validation static audit; no test100 rule selection",
    "identity_information": "category_l1, category_l2, and eligible brand/model supplied separately and not counted in Top-K",
    "top_k": 3,
    "top_k_status": "supplemental_top3_unchanged_for_p2_validation",
    "candidate_filter": "same product_id and quality_status=eligible; exclude Identity, Mandatory, and Negative before Supplemental RRF",
    "ranking": "global reciprocal-rank fusion over title, selling_points, and short_description task rankings",
    "confidence_threshold": "eligible gate; no numeric similarity threshold proposed in this stage",
    "if_fewer_than_k": "return fewer facts; never pad with low-confidence or other-product facts",
    "negative_constraints": "all same-product eligible negative facts are supplied as read-only constraints outside Mandatory and Supplemental Top-K"
  },
  "mandatory_core_policy": {
    "definition_source": {
      "path": "configs/generation_evaluation.json",
      "sha256": "66e97e3d620c83584f2a9bff1757127117043dfe154e4dcbfbfd40cccc7e00bd",
      "field": "core_attributes"
    },
    "formal_denominator_unchanged": true,
    "source_missing_is_injection_failure": false,
    "identity_core_role": "Keep eligible brand/model in Identity and add an identity_mandatory_coverage marker; never duplicate the fact in the Prompt.",
    "task_core_role": "Eligible, single-valued, positive or neutral, actively expressible core facts enter Mandatory Reliable Core Facts.",
    "negative_core_role": "Eligible negative core facts enter Negative Constraints and are not required active coverage.",
    "distinct_multi_value_action": "withhold_review",
    "supplemental_only_rules": [
      {
        "category_l2": "保温杯",
        "field": "适用人群",
        "exact_values": ["大众"],
        "regex_values": ["^[0-9]+后$"],
        "reason": "generic_or_marketing_demographic_not_forced"
      },
      {
        "category_l2": "保温杯",
        "field": "适用场景",
        "exact_values": ["日常送礼", "通用"],
        "reason": "generic_or_gifting_scenario_not_forced"
      },
      {
        "category_l2": "垃圾桶",
        "field": "适用场景",
        "exact_values": ["家庭使用"],
        "reason": "generic_household_scene_not_forced"
      }
    ],
    "value_shape_rules": [
      {
        "category_l2": "收纳箱",
        "field": "净重",
        "regex": "(?i)^[0-9]+(?:\\.[0-9]+)?\\s*(?:kg|g)$",
        "must_be_positive": true,
        "invalid_action": "withhold_review"
      }
    ],
    "prompt_preflight": {
      "tokenize_with_truncation": false,
      "max_input_tokens_unchanged": true,
      "require_every_serialized_mandatory_fact": true,
      "overflow_action": "error",
      "incomplete_injection_action": "error",
      "record_token_id_sha256": true
    }
  },
  "mandatory_core_fields": {
