    "evidence_fields": [
      "structured_source",
      "title_consistency",
      "image_consistency",
      "audit_version"
    ]
  },
  "record_status_policy": {
    "PASS": "Only whitelisted, non-placeholder facts are eligible.",
    "REVIEW": "Keep the frozen record; withhold flagged fields until independent evidence resolves the SKU or boundary. Unrelated stable fields may remain eligible.",
    "CONFLICT": "Keep the frozen record; block conflicting fields. If category/product identity conflicts, block all facts for generation and report Source Fact Error."
  },
  "global_value_gates": {
    "exclude_placeholders": [
      "其他",
      "其它",
      "OTHER",
      "other",
      "未知",
      "不详",
      "默认",
      "见描述",
      "如图",
      "0kg"
    ],
    "multi_value_rule": "Keep multiple values only when they are equivalent after normalization or explicitly represent a set that the task can state without selecting a SKU. Otherwise withhold.",
    "numeric_rule": "Normalize units and compare exact values/ranges. Block incompatible point values, impossible ranges, and unverified marketing capacities.",
    "identity_rule": "Brand/model/category must not conflict with title or image audit evidence.",
    "identity_absent_values": [
      "无",
      "否",
      "没有",
      "未配备"
    ],
    "excluded_values_by_attribute": {
      "型号": [
